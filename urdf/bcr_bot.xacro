<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bcr_bot">

    <!--................................ XACRO CONSTANTS .............................. -->

    <xacro:property name="chassis_mass" value="70"/>
    <xacro:property name="chassis_length" value="0.9"/>
    <xacro:property name="chassis_width" value="0.64"/>
    <xacro:property name="chassis_height" value="0.19"/>

    <xacro:property name="traction_wheel_mass" value="1"/>
    <xacro:property name="traction_wheel_base" value="0.88"/>
    <xacro:property name="traction_max_wheel_torque" value="20000"/>
    <xacro:property name="traction_wheel_friction" value="5.0"/>

    <xacro:property name="trolley_wheel_mass" value="0.1"/>
    <xacro:property name="trolley_track_width" value="0.54"/>
    <xacro:property name="trolley_wheel_friction" value="0.0"/>
    <xacro:property name="trolley_wheel_radius" value="0.06"/>
    <!-- a small constant -->
    <xacro:property name="eps" value="0.002"/>

    <xacro:property name="traction_wheel_radius" value="0.1"/>
    <xacro:property name="traction_wheel_width" value="0.05"/>
    <xacro:property name="traction_track_width" value="0.6"/>

    <xacro:property name="two_d_lidar_update_rate" value="30"/>
    <xacro:property name="two_d_lidar_sample_size" value="361"/>
    <xacro:property name="two_d_lidar_min_angle" value="0"/>
    <xacro:property name="two_d_lidar_max_angle" value="360"/>
    <xacro:property name="two_d_lidar_min_range" value="0.55"/>
    <xacro:property name="two_d_lidar_max_range" value="16"/>

    <!-- Lift platform (Kiva-style): the black top block (skirt + plate) of the mesh rises on a
         prismatic joint. lift_plate_z = top of the plate in chassis_link at the lowest position;
         lift_block_height = skirt + plate (mesh z 252 -> 337 mm). -->
    <xacro:property name="lift_stroke" value="0.08"/>
    <xacro:property name="lift_mass" value="2.0"/>
    <!-- Force PID (gz JointPositionController, see gz.xacro). lift_force_max caps the PID output [N].
         Keep lift_damping LOW. With DART, a high joint damping plus friction at the plate contact
         eats the lift force under load (measured, damping 20000 lifted ~6 kg, 10000 nothing,
         5000 sagged with 20 kg, 500 lifts the 20 kg cart). The braking is done by the PID d_gain.
         The controller is stiff (8 cm in ~0.25 s); a smooth motion has to come from ramped
         setpoints on lift_cmd.
         The joint velocity limit stays loose, because with DART a prismatic joint near a low
         velocity limit misbehaves (gazebosim/gz-sim#2785). -->
    <xacro:property name="lift_force_max" value="1000"/>
    <xacro:property name="lift_effort" value="2000"/>
    <xacro:property name="lift_damping" value="500"/>
    <xacro:property name="lift_joint_velocity_limit" value="1.0"/>
    <!-- High friction on the plate so the cart does not slide when braking or turning. -->
    <xacro:property name="lift_friction" value="1000"/>
    <xacro:property name="lift_plate_z" value="0.132"/>
    <xacro:property name="lift_block_height" value="0.085"/>

    <xacro:property name="camera_baseline" value="0.06"/>
    <xacro:property name="camera_height" value="0.10"/>
    <xacro:property name="camera_horizontal_fov" value="60"/>

    <xacro:arg name="robot_namespace" default=""/>
    <xacro:arg name="wheel_odom_topic" default="odom" />
    <xacro:arg name="camera_enabled" default="false" />
    <xacro:arg name="stereo_camera_enabled" default="false" />
    <xacro:arg name="two_d_lidar_enabled" default="false" />
    <xacro:arg name="publish_wheel_odom_tf" default="true" />
    <xacro:arg name="conveyor_enabled" default="false"/>
    <xacro:arg name="ground_truth_frame" default="map"/>
    <xacro:arg name="sim_gz" default="false" />
    <xacro:arg name="sim_mujoco" default="false" />
    <!-- Dibujar los rayos del lidar en la GUI de Gazebo (upstream usa false; mas barato con varios robots) -->
    <xacro:arg name="lidar_visualize" default="true" />
    <xacro:arg name="odometry_source" default="world" />

    <xacro:property name="odometry_source" value="$(arg odometry_source)"/>
    <!-- Namespace vacío (por defecto) = robot sin prefijo, como upstream.
         Con namespace, todos los links/joints llevan "<ns>/" (necesario para Gazebo
         y para varios robots en el mismo mundo). -->
    <xacro:property name="robot_namespace" value="$(arg robot_namespace)"/>
    <xacro:property name="prefix" value="${robot_namespace + '/' if robot_namespace else ''}"/>

    <!-- ............................... LOAD MACROS ................................. -->

    <xacro:include filename="$(find bcr_bot)/urdf/materials.xacro"/>
    <xacro:include filename="$(find bcr_bot)/urdf/macros.xacro"/>

    <xacro:if value="$(arg sim_gz)">
        <xacro:include filename="$(find bcr_bot)/urdf/gz.xacro"/>
    </xacro:if>

    <xacro:if value="$(arg sim_mujoco)">
        <xacro:include filename="$(find bcr_bot)/urdf/mujoco_ros2_control.xacro"/>
    </xacro:if>

    <!-- ................................ BASE LINK .................................. -->
    <link name="${prefix}base_footprint"/>

    <link name="${prefix}base_link"/>

    <joint name="${prefix}base_joint" type="fixed">
        <parent link="${prefix}base_footprint"/>
        <child link="${prefix}base_link"/>
        <origin xyz="0.0 0 ${chassis_height/2 + traction_wheel_radius}" rpy="0 0 0.0" />
    </joint>

    <link name="${prefix}chassis_link">

        <collision>
            <origin xyz="0 0 -0.05" rpy="0 0 0" />
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>

        <visual>
            <origin xyz="0 0 -0.205" rpy="0 0 0" />
            <geometry>
                <!-- Body only; the top block is the visual of lift_link. -->
                <mesh filename="file://$(find bcr_bot)/meshes/bcr_bot_body.dae" scale="1 1 1"/>
            </geometry>
        </visual>

        <inertial>
            <mass value="${chassis_mass}" />
            <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z = "${chassis_height}"/>
        </inertial>

    </link>

    <joint name="${prefix}chassis_joint" type="fixed">
        <parent link="${prefix}base_link"/>
        <child link="${prefix}chassis_link"/>
        <origin xyz="0.0 0 0" rpy="0 0 0.0" />
    </joint>

    <!-- ................................ WHEELS ..................................... -->

    <xacro:trolley_wheel cardinality="front" dexterity="left" origin_x="${chassis_length/2}" origin_y="${trolley_track_width/2}" origin_z="-${trolley_wheel_radius+chassis_height/2}" prefix="${prefix}"/>
    <xacro:trolley_wheel cardinality="front" dexterity="right" origin_x="${chassis_length/2}" origin_y="-${trolley_track_width/2}" origin_z="-${trolley_wheel_radius+chassis_height/2}" prefix="${prefix}"/>

    <xacro:trolley_wheel cardinality="back" dexterity="left" origin_x="-${chassis_length/2}" origin_y="${trolley_track_width/2}" origin_z="-${trolley_wheel_radius+chassis_height/2}" prefix="${prefix}"/>
    <xacro:trolley_wheel cardinality="back" dexterity="right" origin_x="-${chassis_length/2}" origin_y="-${trolley_track_width/2}" origin_z="-${trolley_wheel_radius+chassis_height/2}" prefix="${prefix}"/>

    <xacro:traction_wheel cardinality="middle" dexterity="left" origin_x="0" origin_y="${traction_track_width/2}" origin_z="-${chassis_height/2+2*trolley_wheel_radius+eps-traction_wheel_radius}" prefix="${prefix}"/>
    <xacro:traction_wheel cardinality="middle" dexterity="right" origin_x="0" origin_y="-${traction_track_width/2}" origin_z="-${chassis_height/2+2*trolley_wheel_radius+eps-traction_wheel_radius}" prefix="${prefix}"/>

    <!-- ............................. 2D LIDAR ........................................ -->

    <xacro:if value="$(arg two_d_lidar_enabled)">

        <link name="${prefix}two_d_lidar">
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="0.06" radius="0.075"/>
                </geometry>
            </collision>

            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="0.06" radius="0.075"/>
                </geometry>
                <material name="aluminium"/>
            </visual>

            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="0.1"/>
                <xacro:cylinder_inertia m="0.1" r="0.075" h="0.06"/>
            </inertial>
        </link>

        <joint name="${prefix}two_d_lidar_joint" type="fixed">
            <parent link="${prefix}base_link"/>
            <child link="${prefix}two_d_lidar"/>
            <origin xyz="0.0 0 0.08" rpy="0 0 0" />
        </joint>

        <gazebo reference="${prefix}two_d_lidar">
            <material>Gazebo/White</material>
        </gazebo>

    </xacro:if>

    <!-- ............................. IMU ........................................ -->

    <link name="${prefix}imu_frame"/>

    <joint name="${prefix}imu_joint" type="fixed">
        <parent link="${prefix}base_link"/>
        <child link="${prefix}imu_frame"/>
        <origin xyz="0.0 0.0 0.08" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- ............................. CAMERA ........................................ -->

    <xacro:if value="$(arg camera_enabled)">

        <!-- KINECT CAMERA -->

        <link name="${prefix}kinect_camera">

            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.07 0.3 0.09"/>
                </geometry>
            </collision>

            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="file://$(find bcr_bot)/meshes/kinect/d415.dae"/>
                </geometry>
                <material name="black"/>
            </visual>

            <inertial>
                <mass value="0.01"/>
                <xacro:box_inertia m="0.01" x="0.07" y="0.3" z = "0.09"/>
            </inertial>

        </link>

        <joint name="${prefix}kinect_camera_joint" type="fixed">
            <origin rpy="0 0 0" xyz="${chassis_length/2} 0 ${chassis_height/7}"/>
            <parent link="${prefix}base_link"/>
            <child link="${prefix}kinect_camera"/>
        </joint>

        <link name="${prefix}kinect_camera_optical"/>

        <joint name="${prefix}kinect_camera_optical_joint" type="fixed">
            <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
            <parent link="${prefix}kinect_camera"/>
            <child link="${prefix}kinect_camera_optical"/>
        </joint>

    </xacro:if>

    <!-- .............................STEREO CAMERA ........................................ -->

    <xacro:if value="$(arg stereo_camera_enabled)">

        <!-- STEREO CAMERA -->

        <link name="${prefix}stereo_camera">

            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.07 0.3 0.09"/>
                </geometry>
            </collision>

            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="file://$(find bcr_bot)/meshes/kinect/d415.dae"/>
                </geometry>
                <material name="black"/>
            </visual>

            <inertial>
                <mass value="0.01"/>
                <xacro:box_inertia m="0.01" x="0.07" y="0.3" z = "0.09"/>
            </inertial>

        </link>

        <joint name="${prefix}stereo_camera_joint" type="fixed">
            <origin rpy="0 0 0" xyz="${chassis_length/2} 0 ${chassis_height/7}"/>
            <parent link="${prefix}base_link"/>
            <child link="${prefix}stereo_camera"/>
        </joint>

        <link name="${prefix}stereo_camera_optical"/>

        <joint name="${prefix}stereo_camera_optical_joint" type="fixed">
            <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
            <parent link="${prefix}stereo_camera"/>
            <child link="${prefix}stereo_camera_optical"/>
        </joint>

    </xacro:if>

    <!-- ............................. LIFT PLATFORM ................................ -->

    <!-- Frame on the top surface of the plate (what touches the cart). -->
    <link name="${prefix}lift_link">

        <collision>
            <origin xyz="0 0 ${-lift_block_height/2}" rpy="0 0 0" />
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${lift_block_height}"/>
            </geometry>
        </collision>

        <visual>
            <!-- Same mesh frame as chassis_link's visual (-0.205), seen from the plate top. -->
            <origin xyz="0 0 ${-0.205 - lift_plate_z}" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find bcr_bot)/meshes/bcr_bot_top.dae" scale="1 1 1"/>
            </geometry>
        </visual>

        <inertial>
            <origin xyz="0 0 ${-lift_block_height/2}" rpy="0 0 0" />
            <mass value="${lift_mass}"/>
            <xacro:box_inertia m="${lift_mass}" x="${chassis_length}" y="${chassis_width}" z="${lift_block_height}"/>
        </inertial>

    </link>

    <joint name="${prefix}lift_joint" type="prismatic">
        <parent link="${prefix}chassis_link"/>
        <child link="${prefix}lift_link"/>
        <origin xyz="0 0 ${lift_plate_z}" rpy="0 0 0" />
        <axis xyz="0 0 1"/>
        <limit lower="0.0" upper="${lift_stroke}" effort="${lift_effort}" velocity="${lift_joint_velocity_limit}"/>
        <dynamics damping="${lift_damping}" friction="0.0"/>
    </joint>

    <!-- ............................. CONVEYOR ........................................ -->

    <xacro:if value="$(arg conveyor_enabled)">

        <link name="${prefix}conveyor_belt">

            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="1 0.6 0.015"/>
                </geometry>
            </collision>

            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="1 0.6 0.015"/>
                </geometry>
            </visual>

            <inertial>
                <mass value="1"/>
                <xacro:box_inertia m="1" x="1" y="0.6" z = "0.015"/>
            </inertial>

        </link>

        <joint name="${prefix}conveyor_joint" type="fixed">
            <parent link="${prefix}base_link"/>
            <child link="${prefix}conveyor_belt"/>
            <origin xyz="0 0 0.25" rpy="0 0 0" />
        </joint>

    </xacro:if>
    <!-- ............................................................................... -->

</robot>
