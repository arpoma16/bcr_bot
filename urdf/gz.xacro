<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bcr_bot">

    <!-- Se incluye desde bcr_bot.xacro (sim_gz:=true), que ya define los args y
         las properties `robot_namespace` y `prefix` usadas aquí.
         `prefix` es "" sin namespace o "<ns>/" con namespace, de modo que los
         topics y frames de Gazebo salen como `scan`/`odom` o `<ns>/scan`/`<ns>/odom`. -->

    <!-- ........................... SENSOR PLUGIN ................................... -->

    <gazebo>
        <!-- El plugin gz-sim-sensors-system se levanta una sola vez a nivel de mundo -->
        <!-- NO descomentar - causa segfault con múltiples robots -->
        <!-- <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin> -->

        <!-- Estos plugins son específicos de cada robot y deberían funcionar -->
        <plugin 
            filename="gz-sim-imu-system" 
            name="gz::sim::systems::Imu">
        </plugin>

        <plugin 
            filename="gz-sim-joint-state-publisher-system" 
            name="gz::sim::systems::JointStatePublisher">
        </plugin>

        <!-- ........................... DIFFERENTIAL DRIVE PLUGIN ................................... -->

        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>${prefix}middle_left_wheel_joint</left_joint>
            <right_joint>${prefix}middle_right_wheel_joint</right_joint>
            <wheel_separation>${traction_track_width+traction_wheel_width-0.01}</wheel_separation>
            <wheel_radius>${traction_wheel_radius+0.01}</wheel_radius>
            <odom_publish_frequency>30</odom_publish_frequency>

            <!-- Topics con namespace del robot -->
            <topic>${prefix}cmd_vel</topic>

            <xacro:if value="${odometry_source == 'encoders'}">
                <odom_topic>${prefix}odometry</odom_topic>
                <tf_topic>${prefix}tf</tf_topic>
            </xacro:if>

            <!-- Frames con namespace -->
            <frame_id>${prefix}odom</frame_id>
            <child_frame_id>${prefix}base_footprint</child_frame_id>
        </plugin>

        <!-- ........................... LIFT PLATFORM ................................... -->
        <!-- Target height of the plate [m, 0 .. lift_stroke] on <ns>/lift_cmd (gz.msgs.Double).
             Force PID. Velocity commands (use_velocity_commands) did not move the joint with DART.
             p saturates the force until ~2 cm from the target, i (capped by i_max) removes the
             sag under the cart weight, and the joint damping sets the speed. -->
        <plugin filename="gz-sim-joint-position-controller-system"
                name="gz::sim::systems::JointPositionController">
            <joint_name>${prefix}lift_joint</joint_name>
            <topic>${prefix}lift_cmd</topic>
            <p_gain>50000</p_gain>
            <i_gain>50000</i_gain>
            <d_gain>0.0</d_gain>
            <i_max>400</i_max>
            <i_min>-400</i_min>
            <cmd_max>${lift_force_max}</cmd_max>
            <cmd_min>${-lift_force_max}</cmd_min>
            <initial_position>0.0</initial_position>
        </plugin>
    </gazebo>

    <!-- ............................. ground truth .................................... -->

    <xacro:if value="${odometry_source == 'world'}">
    <gazebo>
        <plugin filename="libgz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
            <!-- Frames con namespace -->
            <odom_frame>${prefix}odom</odom_frame>
            <robot_base_frame>${prefix}base_footprint</robot_base_frame>

            <!-- Topics con namespace -->
            <odom_topic>${prefix}odometry</odom_topic>
            <tf_topic>${prefix}tf</tf_topic>

            <dimensions>2</dimensions>
            <odom_publish_frequency>50</odom_publish_frequency>
        </plugin>
    </gazebo>
    </xacro:if>

    <!-- ........................... LIFT PLATFORM friction ............................ -->

    <gazebo reference="${prefix}lift_link">
        <mu1>${lift_friction}</mu1>
        <mu2>${lift_friction}</mu2>
    </gazebo>

    <!-- ........................... 2D LIDAR config ................................... -->

    <xacro:if value="$(arg two_d_lidar_enabled)">
        <gazebo reference="${prefix}two_d_lidar">
            <sensor name='gpu_lidar' type='gpu_lidar'>
                <pose>0 0 0 0 0 0</pose>
                <!-- <pose relative_to="${prefix}two_d_lidar">0 0 0 0 0 0</pose> -->
                <topic>${prefix}scan</topic>
                <update_rate>${two_d_lidar_update_rate}</update_rate>
                <!-- gz_frame_id para especificar el frame correcto -->
                <gz_frame_id>${prefix}two_d_lidar</gz_frame_id>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>${two_d_lidar_sample_size}</samples>
                            <resolution>1</resolution>
                            <min_angle>${radians(two_d_lidar_min_angle)}</min_angle>
                            <max_angle>${radians(two_d_lidar_max_angle)}</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>${two_d_lidar_min_range}</min>
                        <max>${two_d_lidar_max_range}</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.001</stddev>
                    </noise>
                </lidar>
                <always_on>1</always_on>
                <visualize>$(arg lidar_visualize)</visualize>
            </sensor>
        </gazebo>
    </xacro:if>

    <!-- ........................... CAMERA config ................................... -->

    <xacro:if value="$(arg camera_enabled)">
        <gazebo reference="${prefix}kinect_camera">
            <sensor type="depth_camera" name="kinect_camera">
                <update_rate>30.0</update_rate>
                <always_on>1</always_on>
                <visualize>true</visualize>

                <!-- Topic con namespace -->
                <topic>${prefix}kinect_camera</topic>

                <!-- Pose del sensor relativo al link -->
                <pose>0 0 0 0 0 0</pose>

                <gz_frame_id>${prefix}kinect_camera</gz_frame_id>

                <camera name="kinect_camera">
                    <horizontal_fov>${radians(camera_horizontal_fov)}</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>8.0</far>
                    </clip>
                    <depth_camera>
                        <clip>
                            <near>0.05</near>
                            <far>8.0</far>
                        </clip>
                    </depth_camera>
                    <distortion>
                        <k1>0.0</k1>
                        <k2>0.0</k2>
                        <k3>0.0</k3>
                        <p1>0.0</p1>
                        <p2>0.0</p2>
                        <center>0.5 0.5</center>
                    </distortion>
                    <lens>
                        <intrinsics>
                            <fx>554.25</fx>
                            <fy>554.25</fy>
                            <cx>320.5</cx>
                            <cy>240.5</cy>
                            <s>0</s>
                        </intrinsics>
                    </lens>
                </camera>
            </sensor>
        </gazebo>
    </xacro:if>

    <!-- ........................... IMU config ................................... -->

    <gazebo reference="${prefix}imu_frame">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>1</update_rate>

            <visualize>true</visualize>

            <!-- Topic con namespace -->
            <topic>${prefix}imu</topic>
            <gz_frame_id>${prefix}imu_frame</gz_frame_id>
        </sensor>
    </gazebo>

    <!-- ........................... Stereo camera ................................... -->
    <xacro:if value="$(arg stereo_camera_enabled)">
        <gazebo reference="${prefix}stereo_camera">
            <sensor type="camera" name="right">
                <update_rate>10.0</update_rate>
                <always_on>true</always_on>

                <pose>0 -0.12 0 0 0 0</pose>

                <!-- Topics con namespace -->
                <topic>${prefix}stereo_camera/right/image_raw</topic>
                <gz_frame_id>${prefix}stereo_camera_optical</gz_frame_id>

                <camera name="right_camera">
                    <horizontal_fov>1.3962634</horizontal_fov>
                    <image>
                        <width>1024</width>
                        <height>1024</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.3</near>
                        <far>20</far>
                    </clip>
                </camera>
            </sensor>

            <sensor type="camera" name="left">
                <!-- Topics con namespace -->
                <topic>${prefix}stereo_camera/left/image_raw</topic>

                <update_rate>10.0</update_rate>
                <always_on>true</always_on>

                <pose>0 0 0 0 0 0</pose>

                <gz_frame_id>${prefix}stereo_camera_optical</gz_frame_id>

                <camera name="left_camera">
                    <horizontal_fov>1.3962634</horizontal_fov>
                    <image>
                        <width>1024</width>
                        <height>1024</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.3</near>
                        <far>20</far>
                    </clip>
                </camera>
            </sensor>
        </gazebo>
    </xacro:if>
</robot>